{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "replayLog",
            "detail": "One-shot replay of a specific log. Runs once and exits.",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "simulateJava",
                "-x",
                "test"
            ],
            "options": {
                "env": {
                    "AKIT_LOG_PATH": "logs\\offseason\\6-13-26\\akit_26-06-13_17-05-06.wpilog"
                }
            }
        },
        {
            "label": "replayLogWatch",
            "detail": "Continuous replay: re-runs automatically on every src/ file save. Stop with Ctrl+C.",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "replayWatch"
            ],
            "options": {
                "env": {
                    "AKIT_LOG_PATH": "logs\\offseason\\6-13-26\\akit_26-06-13_17-05-06.wpilog"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "SimBot",
            "detail": "Sim the robot, QUICK!",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "simulateJava"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "CameraCalibration",
            "detail": "UNTESTED: utility to estimate camera position on robot.",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "streamlit",
                "run", 
                ".\\tools\\camera-calibration\\calibrate.py"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "VisionAnalyzer",
            "detail": "Dashboard to analyze a matches vision metrics.",
            "type": "shell",
            "command": "python",
            "args": [
                "-m",
                "streamlit",
                "run", 
                ".\\tools\\vision-analyzer\\analyze.py"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "MatchPlayerBuild",
            "detail": "Build the current Match Player front end before serving it.",
            "type": "process",
            "command": "npm",
            "args": [
                "--prefix",
                "tools/match-player/web",
                "run",
                "build"
            ],
            "problemMatcher": []
        },
        {
            "label": "MatchPlayer",
            "detail": "Build and serve the current Match Player at http://127.0.0.1:8765 (logs/ picker).",
            "type": "process",
            "command": "python",
            "args": [
                ".\\tools\\match-player\\server\\main.py",
                "--logs",
                ".\\logs"
            ],
            "dependsOn": "MatchPlayerBuild",
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
